PORT=3000
MONGODB_URI=mongodb://localhost:27017/site-constructor

# Row output strategy: console | kafka | redis (switch without code change — Lab 4)
ROW_OUTPUT_STRATEGY=console

# Kafka (only when ROW_OUTPUT_STRATEGY=kafka)
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=site-constructor
# KAFKA_TOPIC=csv-rows

# Redis (only when ROW_OUTPUT_STRATEGY=redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_LIST_KEY=csv-rows

# Dallas Open Data dataset fetch tool (yarn fetch:dataset)
# DATASET_LIMIT=10000
